# Profile de ambiente: dev | stg | prod
TEST_PROFILE=dev

# Reqres.in API Key - Obtenha gratuitamente em: https://app.reqres.in/?next=/api-keys
REQRES_API_KEY=reqres_7b4880206ffa4e6b8429a7291998c7c5

# URLs (sobrescrevem o profile se definidas)
API_BASE_URL=https://reqres.in
E2E_BASE_URL=https://www.saucedemo.com

# URLs por profile (usadas quando API_BASE_URL/E2E_BASE_URL não estão definidas)
# STG_API_BASE_URL=https://stg-api.exemplo.com
# STG_E2E_BASE_URL=https://stg.exemplo.com
# PROD_API_BASE_URL=https://api.exemplo.com
# PROD_E2E_BASE_URL=https://www.exemplo.com

# Modo de execução do navegador
# true  = navegador invisível (ideal para CI/CD e execuções rápidas)
# false = navegador visível (ideal para debug e acompanhamento visual)
HEADLESS=true

# Delay em milissegundos entre cada ação do Playwright (0 = sem delay)
SLOW_MO=0

# Timeout padrão em milissegundos para espera de elementos
TIMEOUT=30000
